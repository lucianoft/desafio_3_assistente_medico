# Backend da LLM: fake (sem GPU, deterministico) | hf (Qwen2.5 + LoRA treinado) | openai (OpenAI ou Groq)
LLM_BACKEND=fake
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
ADAPTER_PATH=models/qwen2.5-1.5b-hospital-lora
MAX_NEW_TOKENS=384
