# Copie para .env (o .env NAO vai para o Git). Usado pela app local e pelo docker compose.

# Backend da LLM:
#   fake   -> deterministico, sem GPU e sem chave (padrao: testes e demo)
#   hf     -> Qwen2.5-1.5B + adaptador LoRA treinado (precisa de torch/transformers; GPU recomendada)
#   openai -> API da OpenAI (ou outro endpoint compativel via OPENAI_BASE_URL)
#   groq   -> API do Groq (modelos abertos, rapido, tem plano gratuito)
LLM_BACKEND=fake

# Temperatura usada por openai e groq
LLM_TEMPERATURE=0

# --- hf -----------------------------------------------------------------------
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
ADAPTER_PATH=models/qwen2.5-1.5b-hospital-lora
MAX_NEW_TOKENS=384

# --- openai -------------------------------------------------------------------
# Chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
# Vazio = api.openai.com; preencha para outro endpoint compativel com a API da OpenAI
OPENAI_BASE_URL=

# --- groq ---------------------------------------------------------------------
# Chave em https://console.groq.com/keys ; modelos em https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Limite da resposta; nos modelos gpt-oss inclui os tokens de raciocinio
GROQ_MAX_TOKENS=1024
# low | medium | high - so para modelos de raciocinio (ex.: gpt-oss); vazio = padrao do modelo
GROQ_REASONING_EFFORT=
GROQ_BASE_URL=https://api.groq.com/openai/v1
