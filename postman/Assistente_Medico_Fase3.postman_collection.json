    {
      "name": "2. Fluxo LangGraph - aprovacao (P001)",
      "description": "Fluxo automatizado: carregar paciente -> verificar exames -> buscar protocolos -> sugerir conduta -> validar seguranca -> emitir alertas -> **pausa** em `registrar_validacao` ate o medico decidir (human-in-the-loop). Rode as requisicoes em ordem: o `trace_id` e guardado em `{{flowTraceId}}`.\n\nO estado do fluxo fica em memoria no processo da API: se reiniciar o uvicorn, inicie o fluxo de novo.",
      "item": [
        {
          "name": "Iniciar fluxo do paciente P001",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fluxos/paciente/P001?solicitante=enfermagem_uti",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fluxos",
                "paciente",
                "P001"
              ],
              "query": [
                {
                  "key": "solicitante",
                  "value": "enfermagem_uti"
                }
              ]
            },
            "description": "Executa ate a validacao humana. Para o P001 gera alerta de RESULTADO_CRITICO (lactato 4,6)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"flowTraceId\", b.trace_id);",
                  "pm.test(\"aguardando validacao medica\", () => { pm.expect(b.status).to.eql(\"AGUARDANDO_VALIDACAO_MEDICA\"); pm.expect(b.aguardando_validacao).to.eql(true); pm.expect(b.proximo_no).to.include(\"registrar_validacao\"); });",
                  "pm.test(\"detectou lactato critico\", () => pm.expect(b.alertas.map(a => a.tipo)).to.include(\"RESULTADO_CRITICO\"));",
                  "pm.test(\"hemocultura pendente\", () => pm.expect(JSON.stringify(b.exames_pendentes)).to.include(\"Hemocultura\"));",
                  "pm.test(\"sugestao com fontes\", () => { pm.expect(b.sugestao).to.be.a(\"string\"); pm.expect(b.fontes).to.be.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar estado do fluxo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fluxos/{{flowTraceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fluxos",
                "{{flowTraceId}}"
              ]
            },
            "description": "Snapshot do estado no checkpointer do LangGraph."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ainda aguardando\", () => pm.expect(pm.response.json().aguardando_validacao).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Medico aprova a sugestao",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fluxos/{{flowTraceId}}/validacao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fluxos",
                "{{flowTraceId}}",
                "validacao"
              ]
            },
            "description": "Retoma o grafo: grava a decisao na tabela `validacoes` e no log de auditoria.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medico\": \"Dra. Ana\",\n  \"aprovado\": true,\n  \"comentario\": \"Ciente do lactato critico\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"sugestao aprovada\", () => pm.expect(b.status).to.eql(\"SUGESTAO_APROVADA\"));",
                  "pm.test(\"fluxo finalizado\", () => pm.expect(b.aguardando_validacao).to.eql(false));",
                  "pm.test(\"decisao registrada\", () => pm.expect(b.decisao_medica.medico).to.eql(\"Dra. Ana\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Auditoria do fluxo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auditoria/{{flowTraceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auditoria",
                "{{flowTraceId}}"
              ]
            },
            "description": "Todas as etapas do fluxo com o mesmo `trace_id`, incluindo a decisao do medico."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const ev = pm.response.json().map(e => e.evento);",
                  "pm.test(\"tem inicio, alertas e validacao\", () => pm.expect(ev).to.include.members([\"fluxo_iniciado\", \"fluxo_alertas_emitidos\", \"fluxo_validacao_medica\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alertas emitidos para o P001",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pacientes/P001/alertas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pacientes",
                "P001",
                "alertas"
              ]
            },
            "description": "Alertas gravados no SQLite (tabela `alertas`)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"existe alerta de resultado critico\", () => pm.expect(pm.response.json().map(a => a.tipo)).to.include(\"RESULTADO_CRITICO\"));"
                ]
              }
            }
          ]
        }
      ]
    },
